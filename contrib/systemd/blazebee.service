[Unit]
Description=BlazeBee system metrics collector
Documentation=https://rubtsov-stan.github.io/blazebee/
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
ExecStart=/usr/bin/blazebee
Environment=BLAZEBEE_CONFIG=/etc/blazebee/config.toml
Restart=on-failure
RestartSec=5s
# SIGTERM triggers a clean MQTT disconnect; the process exits well within this.
TimeoutStopSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=blazebee
LimitNOFILE=1024
UMask=0077

# Sandboxing. The service only reads /proc and /sys, runs `systemctl` for the
# optional systemd collector and connects to the broker.
DynamicUser=yes
CapabilityBoundingSet=
AmbientCapabilities=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
# @clock allows the read-only adjtimex() query of the ntp collector; without
# CAP_SYS_TIME the clock cannot be changed. ProtectClock= is not used because
# it would block that query.
SystemCallFilter=@system-service @clock
# AF_UNIX: journald and D-Bus (systemctl). AF_NETLINK: address resolution.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
